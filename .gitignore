# ============================================================================
# Circular Crack Project - Ignore Rules
# ============================================================================

# Sneddon interpolation data files
# Old numpy format (deprecated)
circular_crack/*.npz
circular_crack/sneddon_interpolation*.npz
# Test data (not for production)
circular_crack/sneddon_python_test.mat

# Debug and documentation markdown files (keep only essential ones)
# In circular_crack directory - ignore all debug MD files
circular_crack/*.md
# Keep if it exists in future
!circular_crack/README.md

# In root directory (keep only README.md)
*.md
!README.md

# Mathematica notebooks used for debugging/reference
circular_crack/*.nb
circular_crack/export_sneddon_data.nb
circular_crack/Circular*.nb

# Test and debug Python scripts
circular_crack/test_*.py
circular_crack/*_test.py
circular_crack/*.txt
circular_crack/debug_*.py
# Comparison tool (dev only)
circular_crack/compare_sneddon_data.py

# CSV and Excel result files from debugging
circular_crack/*.csv
circular_crack/*.xlsx
circular_crack/*.log
circular_crack/comparison_output.log

# Shell scripts for data generation (already executed)
circular_crack/generate_*.sh
circular_crack/*.sh

# Reference data files from Mathematica (for comparison only)
circular_crack/bc.g.ma.dat
circular_crack/SA_coarse_*.dat

# Keep the essential data files (REQUIRED for running)
# Mathematica reference data
!circular_crack/sneddon_SA.mat
# Python-generated data
!circular_crack/sneddon_python.mat

# Credentials
credentials

# reference about slope for L2 norm calculation
circular_crack/crack_singularity_convergence.py

